<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="en-US">
  <info>
    <title>Compact Numeric (thesis-proposal-skills)</title>
    <id>https://github.com/ignacioalvmar/thesis-proposal-skills/compact-numeric</id>
    <link href="https://github.com/ignacioalvmar/thesis-proposal-skills" rel="self"/>
    <summary>Numeric style approximating the legacy compactarticle biblatex look: bracketed numbers, initials, up to five names in the bibliography, DOI shown.</summary>
    <updated>2026-07-29T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">MIT-compatible use within this project</rights>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="et-al">et al.</term>
    </terms>
  </locale>
  <macro name="author">
    <names variable="author">
      <name initialize-with=". " and="text" delimiter=", " et-al-min="6" et-al-use-first="5" name-as-sort-order="all" sort-separator=", " initialize="true" form="long"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title" font-style="italic"/>
      </substitute>
    </names>
  </macro>
  <macro name="title">
    <text variable="title" quotes="true"/>
  </macro>
  <macro name="container">
    <group delimiter=", ">
      <text variable="container-title" font-style="italic"/>
    </group>
  </macro>
  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="access">
    <choose>
      <if variable="DOI">
        <group delimiter=": ">
          <text term="doi" text-case="lowercase"/>
          <text variable="DOI"/>
        </group>
      </if>
      <else-if variable="URL">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography entry-spacing="0" second-field-align="flush" et-al-min="6" et-al-use-first="5">
    <layout>
      <text variable="citation-number" prefix="[" suffix="]"/>
      <group delimiter=". " suffix=".">
        <text macro="author"/>
        <text macro="title"/>
        <text macro="container"/>
        <text macro="year"/>
        <text macro="access"/>
      </group>
    </layout>
  </bibliography>
</style>
