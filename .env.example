# Developer credentials for thesis-proposal-skills — dev-side tooling only.
# Setup: cp .env.example .env, then fill in the values you need. `.env` is
# gitignored; never commit real values. (Students installing the skills use a
# different mechanism — api-keys.env in their own workspace — not this file.)

# Local audit gate (scripts/audit_scan.py). Free account: https://app.snyk.io
# → Account settings → API token.
SNYK_TOKEN=

# Metered OpenRouter runs only: `poe matrix` and the other cost-gated Inspect
# tasks, or a bare `inspect eval` — the cross-vendor rows and the source of
# record, the matrix's own L2 judge included. Dev runs, routing and
# re-grading output that already exists use your Claude subscription and need
# no key here, as long as no ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN or
# CLAUDE_CODE_USE_* is exported in the shell (each makes `claude -p` bill per
# token). A metered call on an Anthropic model needs the gate or an explicit
# approval (AGENTS.md, "Metered model calls"). A key with a low monthly limit
# caps mistakes. Key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional: joins Crossref/arXiv polite pools when testing lit-search scripts;
# an email address, not a secret.
CONTACT_EMAIL=

# Optional: manual testing of the lit-search scripts with OpenAlex coverage.
# Free key: https://openalex.org/settings/api
OPENALEX_API_KEY=
